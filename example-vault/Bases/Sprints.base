filters:
  and:
    - file.inFolder("Sprints")
properties:
  file.name:
    displayName: Sprint
  start:
    displayName: Start
  end:
    displayName: End
  goal:
    displayName: Goal
views:
  - type: table
    name: Current sprint
    filters:
      and:
        - start <= today()
        - end >= today()
    order:
      - file.name
      - start
      - end
      - goal
  - type: table
    name: All sprints
    order:
      - file.name
      - start
      - end
      - goal
    sort:
      - property: start
        direction: DESC
