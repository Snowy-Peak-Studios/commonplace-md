{
  "name": "commonplace-md-vendor",
  "private": true,
  "description": "Builds vendor/vendor.js, the one bundled file of third-party code the app imports, and copies Mermaid's prebuilt vendor/mermaid.min.js, which the app loads only for pages with diagrams. Run: npm install && npm run build",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --target=es2020 --outfile=../../vendor/vendor.js && node -e \"require('fs').copyFileSync('node_modules/mermaid/dist/mermaid.min.js', '../../vendor/mermaid.min.js')\""
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.7.4",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.2.1",
    "esbuild": "^0.24.0",
    "js-yaml": "^4.1.0",
    "lucide": "^0.460.0",
    "markdown-it": "^14.1.0",
    "mermaid": "11.17.2"
  }
}
